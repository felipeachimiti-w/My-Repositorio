# FollowOp BI — Configuração
# Local: copie para .env e preencha
# Vercel: adicione estas variáveis em Settings → Environment Variables
# IMPORTANTE na Vercel: use GOOGLE_CREDENTIALS_JSON (não o PATH)

# ID da planilha Google Sheets (extraído da URL)
SPREADSHEET_ID=19l6cAYq3TP0j7rcNOkUaN0iZf7pUEhA-L5Car8Tkqvk

# Caminho para o JSON da Service Account do Google Cloud
GOOGLE_CREDENTIALS_PATH=credentials.json

# OU: JSON inline das credenciais (alternativa ao arquivo)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Custo de prospecção (WhatsApp)
CUSTO_DISPARO_USD=0.005
COTACAO_USD_BRL=5.70

# Projeção de ROI (parâmetros ajustáveis)
TICKET_MEDIO_ESTIMADO=800
TAXA_CONVERSAO_ESTIMADA=20
